# ImageSrv -- the clock behind the network rollback (issue #56).
#
# OnBootSec=0 is not an optimisation: it is the check that catches the worst
# case. A change that took the network down usually takes the server with
# it, and what follows is a reboot -- so the first thing that must happen on
# the way up is "is there a marker nobody confirmed?". If there is, the
# previous configuration goes back before anyone tries to reach the console.
#
# OnUnitActiveSec=10s gives the sixty-second confirmation window a worst case
# of seventy seconds. Confirming clears the marker, so a confirmed change is
# never touched by a later tick.
#
# AccuracySec=1s: systemd will otherwise coalesce timers by up to a minute,
# which would double the window silently.

[Unit]
Description=ImageSrv: check every ten seconds for an unconfirmed network change
Documentation=https://github.com/NadavOked/ImageSrv-dev/blob/main/docs/server.md

[Timer]
OnBootSec=0
OnUnitActiveSec=10s
AccuracySec=1s
Unit=imagesrv-netrollback.service

[Install]
WantedBy=timers.target
