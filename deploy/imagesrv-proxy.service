# ImageSrv — אינסטנס dnsmasq נפרד למצב PXE proxy (‏#36).
#
# למה יחידה משלו: ‏dnsmasq 2.91 קופא (‏100% מעבד, מפסיק לענות לכל
# הסוקטים, לא מעבד אפילו SIGTERM) ברגע שלקוח UEFI שולח בקשת PXE לפורט
# 4011 במצב proxy. באינסטנס אחד משותף הקפיאה הזו הורגת גם את ה-DHCP של
# וילן ההפצה — כלומר כפתור בקונסולה משבית את שירות הכתובות של המכללה.
# ההפרדה לא מתקנת את הבאג; היא מוודאת שהתהליך שנתקע הוא תהליך שאפשר
# לאבד. ‏systemd יהרוג אותו ב-SIGKILL אחרי TimeoutStopSec וירים מחדש.
#
# הקובץ שהיחידה מריצה נכתב מהקונסולה (לשונית הרשת) והוא **מחוץ**
# ל-/etc/dnsmasq.d, כדי שהאינסטנס הראשי לא יטען אותו. --conf-file לבדו
# מבטל גם את /etc/dnsmasq.conf וגם את conf-dir.
#
# היחידה מותקנת enabled=no בכוונה: הקונסולה מפעילה ועוצרת אותה
# (`systemctl restart/stop imagesrv-proxy`) לפי מצב הכרטיסים, ואחרי
# אתחול היא לא עולה מעצמה — proxy הוא מצב שמדליקים ביודעין.
#
#   sudo cp deploy/imagesrv-proxy.service /etc/systemd/system/
#   sudo systemctl daemon-reload

[Unit]
Description=ImageSrv PXE proxy (isolated dnsmasq instance)
Documentation=https://github.com/NadavOked/ImageSrv-dev
After=network-online.target
Wants=network-online.target
# האינסטנס הראשי מגיש TFTP לוילן ההפצה; זה כאן עצמאי ממנו לגמרי.
After=dnsmasq.service

[Service]
Type=simple
# --test מסרב לעלות על קובץ פגום, ואז restart מחזיר שגיאה לקונסולה
# במקום להשאיר proxy מת בשקט.
ExecStartPre=/usr/sbin/dnsmasq --test --conf-file=/etc/imagesrv/dnsmasq-proxy.conf
ExecStart=/usr/sbin/dnsmasq -k --conf-file=/etc/imagesrv/dnsmasq-proxy.conf --pid-file=
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# הקפיאה לא מגיבה ל-SIGTERM — לא מחכים לה דקה וחצי.
TimeoutStopSec=10
KillMode=mixed

[Install]
WantedBy=multi-user.target
