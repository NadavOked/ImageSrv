# ImageSrv physical operations console (#910 part 2).
# The installer must mask getty@tty1.service before enabling this unit.
[Unit]
Description=ImageSrv DCUI (physical console on tty1)
After=imagesrv-server.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
# Type=exec: active only once python3 actually exec'd -- a failed mount
# namespace (226/NAMESPACE) is then a failed start, not a restart loop that
# firstboot's is-active check mistakes for a running DCUI (21/09).
Type=exec
WorkingDirectory=/opt/imagesrv
ExecStart=/usr/bin/python3 -m server.dcui --data-dir /var/lib/imagesrv
Restart=always
RestartSec=2
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
User=root

# Root is required for systemctl, ifup/ifdown and the directly managed files.
# ProtectSystem remains strict; only the existing ImageSrv write locations are
# opened. AF_UNIX is required by systemd, AF_NETLINK by iproute2, and
# AF_INET/AF_INET6/AF_PACKET by ifup/dhcpcd while applying DHCP.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6 AF_PACKET
# '-' = optional: Debian 13 has dhcpcd (/var/lib/dhcpcd), not isc-dhcp-client;
# a ReadWritePaths entry that does not exist aborts the namespace and the unit
# never starts (found on the first ESXi install, 21/09).
ReadWritePaths=/var/lib/imagesrv /etc/network/interfaces.d /etc -/run/network -/run/dhcpcd -/var/lib/dhcpcd

[Install]
WantedBy=multi-user.target
