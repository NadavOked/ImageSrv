# ImageSrv -- the database backup (issues #1895, #1956; Nadav 06/11).
#
# Driven by imagesrv-backup.timer, every minute. The job backs up when one is
# due -- the daily hour (console setting backup_time), an image uploaded or
# deleted, a destination not backed up to yet -- and otherwise exits 0 at once.
# A round running waits: the next tick asks again, and no day is skipped.
#
# A backup: a consistent copy through sqlite3's backup API, written atomically
# to <dest>/db/imagesrv-<ts>.db, read back (sha256 + integrity_check), the
# oldest copies removed until the reserved space fits (never an image), and
# /var/lib/imagesrv/last-backup.json written -- the health page reads it.
#
# <dest> is /var/lib/imagesrv/backups unless a mounted folder was chosen. SMB
# and NFS are not destinations any more; a server that had one backs up to
# the server's drive and leaves the old share and its fstab line alone.
#
# Not ProtectSystem=strict like imagesrv-server: a chosen folder is another
# disk, anywhere under /mnt, /media or /srv.
#
# The notice levels keep 1440 "Starting/Finished" lines a day out of the
# journal: the job's own lines (a backup done, a failure) and a failed unit
# are at notice or above, the manager's routine lines are at info.

[Unit]
Description=ImageSrv: back up the database when a backup is due
Documentation=https://github.com/NadavOked/ImageSrv/blob/main/docs/architecture/server.md
After=local-fs.target

[Service]
Type=oneshot
WorkingDirectory=/opt/imagesrv
ExecStart=/usr/bin/python3 -m server.system.backup_job --data-dir /var/lib/imagesrv
ProtectSystem=full
NoNewPrivileges=yes
Nice=10
IOSchedulingClass=idle
SyslogLevel=notice
LogLevelMax=notice
