# ImageSrv -- every hour, the database backup (issue #1895, Nadav 22/10).
#
# Persistent=true: an hour missed while the server was off runs at boot.
# The health page marks a backup older than two hours "ישן", so one missed
# run is not yet a warning and two are.

[Unit]
Description=ImageSrv: back up the database every hour
Documentation=https://github.com/NadavOked/ImageSrv-dev/blob/main/docs/server.md

[Timer]
OnCalendar=hourly
Persistent=true
AccuracySec=1min
Unit=imagesrv-backup.service

[Install]
WantedBy=timers.target
