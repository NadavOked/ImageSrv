# ImageSrv -- restore a network change nobody confirmed (issue #56).
#
# This unit exists because the thing it protects against also kills the
# thing that would otherwise do the protecting. Changing the address of
# the interface the console is reached on disconnects the operator, and a
# change that takes the network down takes imagesrv-server down with it
# often enough that a rollback thread inside uvicorn is no protection at
# all: it is not running exactly when it is needed.
#
# So the previous configuration is written to disk with a marker, and this
# unit -- which knows nothing about the server, the database or FastAPI --
# puts it back. It is driven by imagesrv-netrollback.timer, which fires at
# boot (OnBootSec=0) and every ten seconds after that. The boot run is the
# important one: an open marker after a reboot means the change was never
# confirmed, and the marker carries the boot id it was written under, so
# "the machine came back up with an unconfirmed change" is a fact we can
# read rather than guess.
#
# Install (see docs/server-install.md):
#
#   sudo install -m 0644 deploy/imagesrv-netrollback.service \
#                        deploy/imagesrv-netrollback.timer \
#                        /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now imagesrv-netrollback.timer
#
# The console refuses any change that could cut the console off while this
# timer is not active. A guard that was not proven to be there is not a
# guard, and without it the change is one-way.

[Unit]
Description=ImageSrv: restore an unconfirmed network configuration
Documentation=https://github.com/NadavOked/ImageSrv-dev/blob/main/docs/server.md
# Late enough that ifup works, early enough to fix the boot we came up in.
After=network-pre.target local-fs.target
DefaultDependencies=no

[Service]
Type=oneshot
WorkingDirectory=/opt/imagesrv
# --state-dir must match the server's: it defaults to <data-dir>/netcfg, and
# the server's data dir is /var/lib/imagesrv. Two different paths here would
# mean the marker is written in one place and read in another -- which looks
# exactly like a guard that works, and is a guard that never fires.
ExecStart=/usr/bin/python3 -m server.net.netcfg_rollback --state-dir /var/lib/imagesrv/netcfg
# The rollback writes /etc/network/interfaces.d and /etc/resolv.conf and runs
# ifup, so it needs root and those paths writable.
ProtectSystem=strict
ReadWritePaths=/var/lib/imagesrv /etc/network/interfaces.d /etc -/run/network -/run/dhcpcd -/var/lib/dhcpcd
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
