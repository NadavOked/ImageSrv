# ImageSrv USB @VERSION@ -- #1914. Legacy BIOS (syslinux), only with USB_BIOS_LOADER=syslinux (#2186). Same kernel line as grub.cfg.
DEFAULT imagesrv
PROMPT 0
TIMEOUT 0
# #2453: nobody edits the kernel line -- no boot: prompt from Shift/Alt/Caps Lock, no options but APPEND.
NOESCAPE 1
ALLOWOPTIONS 0
LABEL imagesrv
    KERNEL /imagesrv/vmlinuz
    INITRD /imagesrv/initrd.img
    APPEND imagesrv.mode=usbclone console=tty0 quiet loglevel=3
