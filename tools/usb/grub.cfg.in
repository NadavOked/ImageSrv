# ImageSrv USB @VERSION@ -- #1914. UEFI: shim -> grubx64.efi, both Debian-signed.
# Legacy BIOS (#2186): GRUB i386-pc reads this same file (tools/usb/grub-bios.cfg).
# One entry, no menu, no timeout. The kernel line carries exactly one imagesrv.*
# word, imagesrv.mode=usbclone (CLAUDE.md principle 2): no imagesrv.server, no task.
set timeout=0
set default=0
menuentry "ImageSrv USB @VERSION@" {
    linux /imagesrv/vmlinuz imagesrv.mode=usbclone console=tty0 quiet loglevel=3
    initrd /imagesrv/initrd.img
}
