# ‏#1190: ערך אחד, בלי תפריט — ה-ISO עולה ישר למתקין החי; התפקיד, הדיסק
# וכל השאר נשאלים בגואי על המסך. שורת הקרנל: רק imagesrv.mode=installer.
set default=0
set timeout=0
set color_normal=white/black
set color_highlight=black/light-gray
background_color '#1b2a41'
# כמו ב-grub.cfg של ה-netinst: בלי gfxterm אין רקע ואין צבעים; אם אין
# פונט — נשארים בטקסט, והתפריט עדיין עובד.
if loadfont $prefix/font.pf2 ; then
    set gfxmode=auto
    insmod efi_gop
    insmod efi_uga
    insmod gfxterm
    terminal_output gfxterm
fi
echo 'ImageSrv @TAG@ installer'
# #2450: e and c are locked for everyone -- superusers names a user that has
# no password here, so nobody can edit the kernel line or open the command
# line. An ISO is built before any server exists and cannot know the password of a server;
# one baked in at build time would be in every published copy.
# Booting the entry asks nothing (--unrestricted).
set superusers="imagesrv"

menuentry --hotkey=m 'ImageSrv server install' --unrestricted {
    set background_color='#1b2a41'
    linux    /live/vmlinuz @DI_ARGS@ --- quiet
    initrd   /live/initrd.img
}
