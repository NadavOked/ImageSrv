#!/bin/sh
# init -- PID 1 of the ImageCtl initramfs. Mounts the pseudo-filesystems,
# loads drivers, brings the network up with DHCP, then hands over to the
# agent. If anything here fails, the machine reboots -- which lands back
# in GRUB, whose default is the local disk.

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

fail() {
    echo "ImageSrv: $1 -- rebooting in 5s"
    sleep 5
    sync
    reboot -f
}

# One poll tick, same as poll_tick in lib/waits.sh (#1450, #1451): _tk =
# tenths slept; a busybox that refuses `sleep 0.1` costs a real second.
poll_tick() { if sleep 0.1 2>/dev/null; then _tk=1; else sleep 1; _tk=10; fi; }

mount -t proc     proc     /proc  2>/dev/null
mount -t sysfs    sysfs    /sys   2>/dev/null
mount -t devtmpfs devtmpfs /dev   2>/dev/null
mkdir -p /dev/pts /run
mount -t devpts   devpts   /dev/pts 2>/dev/null
mount -t tmpfs    tmpfs    /run   2>/dev/null
mkdir -p /run/imagectl
# Boot markers (#1452): /proc/uptime at init, modules, nic, link and dhcp.
# No network before DHCP, so they ride on the agent-net breadcrumb below.
_up=""
boot_mark() { _up="$_up${_up:+,}$1:$(cut -d' ' -f1 /proc/uptime 2>/dev/null)"; }
boot_mark init
RUN_DIR="${RUN_DIR:-/run/imagectl}"
LIB_DIR="${LIB_DIR:-/usr/lib/imagectl}"

# Storage and NIC drivers. The list is generated at build time. A module that
# does not load has two opposite meanings, and folding them into one line taught
# the operator to ignore the message (#407, principle 5): a *platform* driver
# not loading is the expected case -- 8 virtualization drivers on bare metal,
# plus whatever NIC/disk hardware this machine simply does not have -- while a
# *required* module (the filesystem set in /etc/imagectl/modules.required) not
# loading is a broken initramfs that will let restore corrupt data silently
# (#84, #107, #121). Both are reported BY NAME, never as a bare count: `9
# modules did not load` is the same digit whether all nine were superfluous or
# one was the network driver a headless machine needed to stay reachable.
#
# ‏`2>/dev/null` לבדו הפך כל כישלון טעינה לבלתי-נראה, ומודול שלא נטען
# נראה בדיוק כמו מודול שנטען. ‏`sungem: Unknown symbol` נמצא ככה רק
# כשהודפס dmesg ידנית במעבדה. סופרים, מסווגים ומדווחים בשם (#76, #407).
MOD_DIR="${MOD_DIR:-/etc/imagectl}"
_required=" $(tr '\n' ' ' < "$MOD_DIR/modules.required" 2>/dev/null) "
_req_fail=""
_opt_fail=""
_dmi="$(cat /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/product_name 2>/dev/null)"
_hypervisor=0
grep -q '[[:space:]]hypervisor\([[:space:]]\|$\)' /proc/cpuinfo 2>/dev/null && _hypervisor=1
platform_module_expected() {
    case "$1:$_dmi" in
        hv_*:*Microsoft*|hv_*:*Hyper-V*) return 0 ;;
        vmw_*:*VMware*|vmxnet3:*VMware*) return 0 ;;
        xen-*:*Xen*) return 0 ;;
        virtio_*:*) [ "$_hypervisor" = 1 ]; return ;;
    esac
    return 1
}
# The loading itself is lib/initmods.sh (#1702): NIC first so the link negotiates
# while the rest loads, and only the NIC/GPU drivers this hardware asks for.
[ -f "$LIB_DIR/initmods.sh" ] || fail "initramfs without initmods.sh"
. "$LIB_DIR/initmods.sh"
[ -f "$MOD_DIR/modules" ] && mods_load_all
[ -n "$_opt_fail" ] && \
    echo "ImageSrv: platform modules absent, expected on this hardware: $_opt_fail"
if [ -n "$_req_fail" ]; then
    printf '%s\n' "$_req_fail" | tr ' ' '\n' | awk 'NF' > "$RUN_DIR/modules.failed.next" \
        || fail "could not write the required-module failure list"
    mv "$RUN_DIR/modules.failed.next" "$RUN_DIR/modules.failed" \
        || fail "could not publish the required-module failure list"
    echo "ImageSrv: ERROR required modules did not load, restore may corrupt: $_req_fail"
else
    rm -f "$RUN_DIR/modules.failed"
fi
boot_mark modules

# intel_pstate does not support pre-Sandy Bridge CPUs.  Debian provides the
# fallback as a module, so try it before the agent starts doing CPU-heavy work.
# Optional by design (principle 1): a missing helper never stops the boot.
if [ -f "$LIB_DIR/cpufreq.sh" ]; then
    . "$LIB_DIR/cpufreq.sh"
    cpufreq_performance
fi

# efivars for the SecureBoot bit in hello -- after the module load, because
# efivarfs is itself one of them (CONFIG_EFIVAR_FS=m).
#
# מכונת BIOS פשוט אין לה /sys/firmware/efi, וזה לא כישלון. אבל מכונת
# UEFI שה-efivars שלה לא נעגן היא מכונה שאיננו יודעים מה מצב ה-Secure
# Boot שלה — וזה בדיוק מה ש-hello יגיד עליה. קודם לכן זה נבלע, המודול
# לא היה שם בכלל, וכל מכונה דיווחה "כבוי" (#84).
if [ -d /sys/firmware/efi ]; then
    mkdir -p /sys/firmware/efi/efivars
    mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null \
        || echo "ImageSrv: efivarfs would not mount -- SecureBoot state unknown"
fi

# Give USB/PCI enumeration up to 2s, continuing as soon as a NIC appears
# (#1451; was a fixed `sleep 2`). None by then is not an error here: the
# DHCP loop below keeps looking for 90s.
_nic_t=0
while [ "$_nic_t" -lt 20 ]; do
    _nic_found=0
    for _d in /sys/class/net/*; do
        [ -e "$_d" ] || continue
        [ "${_d##*/}" = lo ] || { _nic_found=1; break; }
    done
    [ "$_nic_found" = 1 ] && break
    poll_tick; _nic_t=$((_nic_t + _tk))
done
[ "$_nic_found" = 1 ] && boot_mark nic

# --- the install ISO (#1190) --------------------------------------------------
# imagectl.mode=installer on the kernel line: this image was booted from the
# ImageCtl install ISO, not by PXE. The live installer needs no lease (the
# install is offline) and must never reboot-loop on a network that is not
# there yet, so it takes over before the DHCP loop below. Only parse_cmdline
# reads the kernel line (principle 2); the mode is one of its two words.
if [ -f "$LIB_DIR/common.sh" ]; then
    . "$LIB_DIR/common.sh"
    parse_cmdline
    if [ "$IMAGECTL_MODE" = installer ]; then
        [ -f "$LIB_DIR/installer_boot.sh" ] || fail "installer image without installer_boot.sh"
        . "$LIB_DIR/installer_boot.sh"
        installer_boot
        fail "installer handover returned"
    fi
    # #1914: the clone stick -- no server and no lease to wait for; the agent
    # goes straight to the local clone screen (usbclone.sh). No NIC is brought up.
    if [ "$IMAGECTL_MODE" = usbclone ]; then
        exec /usr/bin/imagectl-agent
    fi
fi

# --- network -----------------------------------------------------------------
# #2040: a build machine has two cabled NICs, deploy and classroom, in either
# order. Ours is the NIC whose lease came from OUR server (DHCP server-id ==
# the imagectl.server host) -- never the first lease in name order. Each
# carrier NIC gets a one-shot probe (-q; the hook only records the lease), and
# the one that is ours gets the resident udhcpc that renews (#1949). None ours
# = no guess: the deadline reboots, and GRUB's default is the local disk
# (principle 1). -V is how the deploy NIC's dnsmasq tells us from Windows
# (AGENT_VENDOR_CLASS in server/dhcp.py).

ip link set lo up 2>/dev/null

IFACE=""
_foreign=""
_srv=${IMAGECTL_SERVER#*://}; _srv=${_srv%%[:/]*}
_link_marked=0
_deadline=$(( $(date +%s) + 90 ))
while [ -z "$IFACE" ]; do
    for _d in /sys/class/net/*; do
        [ -e "$_d" ] || continue
        _n=${_d##*/}
        [ "$_n" = "lo" ] && continue
        ip link set "$_n" up 2>/dev/null
    done
    # Poll every interface's carrier for up to 1s per pass (#1451; was a
    # `sleep 1` per interface): autonegotiation is noticed within 0.1s.
    _carrier_t=0
    while [ "$_carrier_t" -lt 10 ]; do
        _carrier_found=0
        for _d in /sys/class/net/*; do
            [ -e "$_d" ] || continue
            _n=${_d##*/}
            [ "$_n" = "lo" ] && continue
            _carrier=$(cat "$_d/carrier" 2>/dev/null || echo 0)
            [ "$_carrier" = "1" ] && { _carrier_found=1; break; }
        done
        [ "$_carrier_found" = 1 ] && break
        poll_tick; _carrier_t=$((_carrier_t + _tk))
    done
    _tried=0
    for _d in /sys/class/net/*; do
        [ -e "$_d" ] || continue
        _n=${_d##*/}
        [ "$_n" = "lo" ] && continue
        _carrier=$(cat "$_d/carrier" 2>/dev/null || echo 0)
        [ "$_carrier" = "1" ] || continue
        case " $_foreign " in *" $_n "*) continue ;; esac   # its network does not move
        [ "$_link_marked" = 1 ] || { boot_mark link; _link_marked=1; }
        _tried=1
        rm -f "/run/imagectl/dhcp-probe.$_n"
        udhcpc -i "$_n" -n -q -t 4 -T 3 -V ImageSrv-agent \
            -s /etc/imagectl/udhcpc.probe >/dev/null 2>&1 || continue
        _sid=$(sed -n 's/^serverid=//p' "/run/imagectl/dhcp-probe.$_n" 2>/dev/null)
        if [ -z "$_srv" ] || [ "$_sid" != "$_srv" ]; then
            echo "ImageSrv: $_n has a lease from '${_sid:-?}', not from the server '${_srv:-?}' -- not used (#2040)"
            _foreign="$_foreign $_n"
            continue
        fi
        # No -q (#1949): once bound, udhcpc backgrounds and renews the lease
        # at T1. With -q it exited, the 12h lease lapsed under a long run,
        # dnsmasq dropped it, and the identity check refused every report.
        if udhcpc -i "$_n" -n -t 4 -T 3 -V ImageSrv-agent \
            -s /etc/imagectl/udhcpc.script >/dev/null 2>&1; then
            IFACE="$_n"
            break
        fi
    done
    [ -n "$IFACE" ] || [ "$_tried" = 1 ] || poll_tick   # every carrier NIC foreign: no spin
    [ -n "$IFACE" ] || [ "$(date +%s)" -lt "$_deadline" ] || fail \
        "no DHCP lease ${_foreign:+from the ImageSrv server ${_srv:-?} }on any interface${_foreign:+ (another network on:$_foreign)}"
done
boot_mark dhcp

# #2040: every other NIC goes down for the whole run -- the agent works on the
# deploy network only. A NIC that refuses is said on the console, not hidden;
# it still has no address (the probe configures nothing).
NICS_DOWN=""
for _d in /sys/class/net/*; do
    [ -d "$_d" ] || continue      # a NIC is a directory; bonding_masters is a file
    _n=${_d##*/}
    [ "$_n" = "lo" ] || [ "$_n" = "$IFACE" ] && continue
    if ip link set "$_n" down 2>/dev/null; then
        NICS_DOWN="$NICS_DOWN${NICS_DOWN:+ }$_n"
    else
        echo "ImageSrv: WARNING $_n would not go down -- it stays up without an address (#2040)"
    fi
done
[ -z "$NICS_DOWN" ] || echo "ImageSrv: server on $IFACE; down for this run: $NICS_DOWN (#2040)"

IP=$(ip -4 addr show "$IFACE" 2>/dev/null \
     | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -n 1)
[ -n "$IP" ] || fail "DHCP succeeded but no address on $IFACE"

printf 'IFACE=%s\nIP=%s\nNICS_DOWN="%s"\n' "$IFACE" "$IP" "$NICS_DOWN" > /run/imagectl/net.conf
echo "ImageSrv: network up on $IFACE ($IP)"

# --- boot trace (#400) --------------------------------------------------------
# The first thing this machine can say for itself. It proves three things at
# once: the initramfs unpacked, this script ran to here, and DHCP answered.
#
# There is deliberately no earlier breadcrumb for "init started": before DHCP
# there is no network and nothing to report over. If this one is missing while
# GRUB's pre-boot arrived, THAT gap is the finding -- which is the whole point
# of keeping the step list closed on the server (boot/trace.py).
#
# common.sh is sourced rather than parsed again here: the kernel command line
# has exactly one reader in this codebase (parse_cmdline), and a second one
# would be a second, undocumented interface -- principle 2, guarded by
# test_only_common_touches_proc_cmdline.
#
# Never fatal, and never silent: trace_step always returns 0 and logs a
# failed delivery. A diagnostic that stops a machine booting is damage.
if [ -f "$LIB_DIR/common.sh" ]; then
    SERVER="$IMAGECTL_SERVER"
    MAC=$(cat "/sys/class/net/$IFACE/address" 2>/dev/null)
    trace_step agent-net "up=$_up"
fi

# --- hand over ---------------------------------------------------------------

/usr/bin/imagectl-agent
fail "agent exited"
