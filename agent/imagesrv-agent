send_hello() {
    build_hello > "$RUN_DIR/hello.json" || return 1
    [ -n "$_traced_hello" ] || { trace_step agent-hello; _traced_hello=1; }
    hello_post "$SERVER/api/v1/agent/hello" "$RUN_DIR/hello.json" "$RESP" || return 1
    rm -f "$RUN_DIR/wol_armed"
    lc_report_resend   # #1913: a local clone's report the server missed while it was down
}

read_answer() {
    D_SCHEMA=$(json_get "$RESP" ".schema")
    D_KNOWN=$(json_get "$RESP" ".known")
    D_ROLE=$(json_get "$RESP" ".role")
    D_TASK=$(json_get "$RESP" ".task")
    D_SESSION_STATE=$(json_get "$RESP" ".session.state")
    [ "$D_SESSION_STATE" = "null" ] && D_SESSION_STATE="none"
    D_MODE="$IMAGESRV_MODE"
    D_SESSION_ID=$(json_get "$RESP" ".session.id")     # for poll.sh (#136)
    D_REQUIRE_LOGIN=$(json_get "$RESP" ".ui.require_login")
    min_free_take "$RESP"; timing_take "$RESP"; tail_shrink_take "$RESP"; hdd_support_take "$RESP"; ask_keep "$RESP"   # #3654: the brain's questions about this machine; X16: the local clone keeps the last HDD switch; #1354: the console's minimum free space (the local clone keeps the last one); #2056/#2059 waits, power-off
}

build_console_screen() {
    if ! gui_parent; then
        [ "$_build_standby" = "1" ] && return 0
        gui_unavailable_local build   # GUI only (11/10): no text menu behind it
    fi
    shrink_offer_pending   # #926: a disk left shrunk is offered back once per boot -- a GUI dialog (11/10)
    build_round_end; interrupt_ask_build   # #1560: a round opened from this GUI ended -- power off, or the menu; #2528: or waits for a decision
}
do_restore_drawers() {
    # $1 = image id, $2 = session id. Cloning room: 2-3 drawers at once.
    identify_watch_stop; idle_wc_hold   # #1966: no identification read may overlap this round; #3271: nor a new waiting-screen write check (idlegate.sh)
    smart_selftest_cancel           # #1970: background diagnostics never overlap a round
    resolve_target_drawers          # #695: sets $_disks; die_local on a bad mapping (drawerselect.sh)
    rm -f "$RUN_DIR/server-restarted-wave" "$RUN_DIR/session-closed" "$RUN_DIR/session-closed.why"   # 17/10: progress_loop's mark (verdict.sh)
    [ -n "$_disks" ] || { log "no drawers detected -- waiting"; sleep 5; return 0; }

    http_get "$SERVER/api/v1/images/$1/manifest" > "$RUN_DIR/manifest.json" \
        || die_local "manifest fetch failed"
    session_stream "$1" "$RUN_DIR/manifest.json" "$RESP" || die_local "$STREAM_REFUSAL"; chunk_gate "$RESP" "$RUN_DIR/manifest.json" || die_local "$CHUNK_REFUSAL"   # #1826; #2533: STREAM_MODE
    _total=$(json_get "$RUN_DIR/manifest.json" ".total_compressed_bytes")
    job_reset   # #1916: a failed round's 'failed' would close this round's member at its first report
    for _d in $_disks; do
        target_init "$_d" "$_total"
    done

    session_open_gate "$2" "$MAC" "$SERVER" || die_local "$OPEN_GATE_WHY"   # #2657: the server says this round is open for us -- before any disk I/O
    progress_loop "$2" "$MAC" "$SERVER" &
    _ppid=$!

    # שער SMART לפני כתיבה (#652); בלי שאלה (#2044).
    # shellcheck disable=SC2086 # the disk list is a word list on purpose
    log "gap: drawers_bound begin" >&2; _all=$_disks; _disks=$(drawers_bound $_disks); log "gap: drawers_bound end" >&2; log "gap: smart_gate begin" >&2; _disks=$(smart_gate "$2" $_disks); _gr=$?; log "gap: smart_gate end rc=$_gr" >&2   # #1760: _all = the end count's, red skips included; #2434: identity first (drawerselect.sh)
    # #1560: a round where every drawer was skipped ended too -- reported, the count, power-off
    [ "$_gr" = 0 ] || { echo failed > "$RUN_DIR/state"; round_beep failure; end_failed_round "all drawers skipped" "$2" "$_ppid"; return 1; }   # #2910: job_reset left 'waiting' -- the report says what is the case
    log "gap: drawer_gates begin" >&2; _disks=$(EXPAND_OVERRIDE=$(json_get "$RESP" ".session.expand_partition") drawer_gates $_disks); log "gap: drawer_gates end" >&2   # #1808 old RAID metadata, #1898 the split: asked (drawergate.sh)
    [ -n "$_disks" ] || { echo failed > "$RUN_DIR/state"; round_beep failure; end_failed_round "all drawers skipped" "$2" "$_ppid"; return 1; }   # #2910
    log "writing $(echo "$_disks" | wc -w) drawers: $_disks"

    # shellcheck disable=SC2086 # the disk list is a word list on purpose
    WRITEMARK_HOLD=1; EXPAND_OVERRIDE=$(json_get "$RESP" ".session.expand_partition") run_restore_drawers "$STREAM_MODE" "$SERVER" "$1" "$RUN_DIR/manifest.json" $_disks
    _rc=$?; crc_delta_measure $_disks; smart_note_apply $_disks   # #872: 199 פעם אחת אחרי הכתיבה, בהצלחה ובכשל; #2042: the orange note
    # shellcheck disable=SC2086 # #2786: each drawer's computer name, then #1269: drivers by the chosen model, per drawer, before the report
    [ "$_rc" -eq 0 ] && { name_drawers $_disks; stage_drawer_drivers "$2" "$RUN_DIR/manifest.json" $_disks; }
    # shellcheck disable=SC2086 # #1877: each done drawer's mark comes off after its drivers; one that stays fails that drawer
    WRITEMARK_HOLD=0; writemark_release_done $_disks || { _f=$(_machine_state "$_disks"); echo "$_f" > "$RUN_DIR/state"; [ "$_f" != failed ] || _rc=1; }
    EXPAND_OVERRIDE=$(json_get "$RESP" ".session.expand_partition") prodline_finish "$2" "$1" "$SERVER" && _rc=0   # #3181: a production line -- written drawers are detached; a disk that joined mid-round ends here, and the machine stays in the wave until it does
    if [ "$_rc" -eq 0 ]; then
        _f=$(_machine_state "$_disks"); echo "$_f" > "$RUN_DIR/state"
        # Nadav 17/10: a cloner powers off in every state, an unconfirmed
        # "done" too. The report goes on until the power-off.
        # shellcheck disable=SC2086 # includes drawers skipped before writing. #3125: asked before the final
        round_beep_result $_all   # report, so that it carries the end tune ("requested"; what came of it is in the log)
        report_final "$_ppid" "$2" "$MAC" "$SERVER" \
            || { log "the done report was not confirmed -- the count runs all the same"; progress_loop "$2" "$MAC" "$SERVER" & }
        agent_log_send "$2"   # #1882: the log tail, kept on the server (best effort)
        # Drawers are swapped with the machine off (spec appendix A), so
        # powering down IS the next step of the round, not a failure.
        log "drawers complete -- powering off for the swap"
        [ "${IMAGESRV_TEST:-0}" = "1" ] && exit 0
        # #1560: 20 s on the screen, or "כבה עכשיו"; #2024: a drawer with a problem = the results until "כבה"
        # shellcheck disable=SC2086 # (Nadav 17/10). #1222/#1483: returns only when it stayed on -- still done.
        end_tally $_all; _k=drawers; [ "$_et_ok" = "$_et_n" ] || _k=partial
        # shellcheck disable=SC2086 # _all: each drawer's result decides, the ones the SMART gate skipped too
        end_countdown "$_k" "drawers complete ($_et_ok of $_et_n)" "$_et_ok" "$_et_n" $_all || task_done_stays_on "Drawers complete. The drives were written."; return 0
    fi
    # #1560 (ברזל 17/10): משכפל שנשאר דלוק אחרי כשל לא הצטרף לסבב הבא. הכשל
    # מדווח ל-'failed' (הקונסולה רואה אותו), מוצג לספירה, והמכונה נכבית.
    _why="no drawer completed"; round_closed && _why="the server closed this round -- writing stopped"
    round_beep failure
    end_failed_round "$_why" "$2" "$_ppid"
}

do_restore() {
    _img=$(json_get "$RESP" ".session.image_id")
    _ses=$(json_get "$RESP" ".session.id")
    [ "$_img" != "null" ] && [ "$_ses" != "null" ] \
        || die_local "running session without image or id"

    if [ "$D_ROLE" = "cloner" ]; then
        do_restore_drawers "$_img" "$_ses"
        return $?
    fi

    # #3173: a classroom station (any machine that is not a cloner) received its
    # round from the old multicast receiver, which is gone; the chunk engine writes drawers only. It
    # fails by name before a byte of the disk is touched (principle 1: the local
    # disk stays whole), and the server is told 'failed' with the reason.
    _why="a station restore over the network arrives in version 2 -- nothing written"
    _disk=$(pick_internal_disk) || die_local "restore: $_why"
    log "restore: $_why"
    job_reset; target_init "$_disk" 0; target_set "$_disk" failed "$_why"; echo failed > "$RUN_DIR/state"
    progress_loop "$_ses" "$MAC" "$SERVER" &
    report_final "$!" "$_ses" "$MAC" "$SERVER" || { hold_unheard "$_ses"; return 1; }
    round_beep failure; ui_error_hold "$_why" hold_beat; return 1
}

# --- main loop ---------------------------------------------------------------

_fails=0
_logged_wait=0
while :; do
    watchdog_beat
    if ! send_hello; then
        _fails=$((_fails + 1))
        [ "$_fails" -ge 30 ] && die_local "server unreachable"
        sleep 2
        continue
    fi
    _fails=0
    read_answer
    watchdog_start; monitor_start   # #690: RFB once role known; re-entrant, logged
    power_watch_start; sata_lpm_cloner   # #1918: the power button; #1827: SATA LPM -- once the role is known; re-entrant
    disk_uevent_start   # #1971: kernel-driven insert/remove detection
    idle_wc_start   # #3268: the write check, with a copy, of every disk in the drawers -- at boot and on every insertion

    _dec=$(decide); gui_early_settle "$_dec"   # #1709: a path with no GUI closes the early one first
    case "$_dec" in
        local)
            die_local "no work for this machine"
            ;;
        bad_answer) die_local "server answer not understood (unsupported schema)" ;;   # #2666
        unknown)
            ui_unknown "$MAC"   # #1802: the screen until F2, then a reboot to the local disk
            die_local "MAC not registered"   # only if that reboot did not happen
            ;;
        task)
            netwatch_stop   # #3064: a sample that overlaps work is not an idle sample
            do_task
            ;;
        recovery)
            if gui_parent; then poll_sleep; else gui_unavailable_local recovery; fi
            ;;
        wait_open)
            # A station on the class network waits for nothing -- the stream
            # never reaches its vlan. One hello is enough, no loop (#136).
            netwatch_stop   # #3064: this machine is joining -- not an idle window any more
            poll_off_deploy_vlan && die_local "the round is on another vlan"
            if ! gui_parent; then ui_waiting_draw \
                "$(json_get "$RESP" ".session.prefix")" \
                "$(json_get "$RESP" ".session.joined")" \
                "$(json_get "$RESP" ".session.expected_clients")" \
                "$(json_get "$RESP" ".session.starts_in_seconds")"
            fi
            poll_sleep
            ;;
        wait_poll)
            if [ "$_logged_wait" = "0" ]; then
                log "cloner: reporting drawers, waiting for work"
                # ‏probe חד-פעמי כדי שה-hello יישא בריאות SMART והקונסולה
                # תראה אותה *לפני* שהמפעיל משגר סבב (דרישת נדב #652).
                # shellcheck disable=SC2046 # the drawer list is a word list
                smart_probe_idle $(list_drawers)
                _logged_wait=1
            fi
            idle_wc_release; local_clone_arm   # #3271: back on the waiting screen -- the write check may run again (idlegate.sh); #1322: the boot choice is the first thing the GUI draws
            gui_cloner_parent; interrupt_told; local_clone_offer   # מסך "ממתין לסבב" + התקדמות; 0 גם בלי מסך; #2528: the round waits for a decision
            identify_watch_start; smart_selftest_idle_start; cable_live_check; netwatch_idle_start   # #1966/#1970/#1968/#3064: idle only
            poll_sleep
            ;;
        build_console)
            build_console_screen
            poll_sleep
            ;;
        restore)
            netwatch_stop   # #3064
            gui_restore_parent
            do_restore
            ;;
    esac

    [ "${IMAGESRV_TEST:-0}" = "1" ] && [ -n "${IMAGESRV_TEST_ONCE:-}" ] && break
done
