#!/bin/sh
# imagesrv-installer -- the live installer's console process (#1190). POSIX sh.
# init exec's this after the media is mounted and temporary DHCP ran. It puts
# the native GUI on the framebuffer in install mode; the GUI drives the engine
# through installer/gui-bridge.sh (part 2), and asks the bridge to eject the
# media and reboot when the person presses "restart" or the done screen's
# countdown runs out (#1250). This process therefore
# never reboots by itself, and when it cannot show anything it says why on
# the text console and waits -- a person is in front of this screen.
set -u

INSTALLER_DIR="${INSTALLER_DIR:-/usr/lib/imagesrv/installer}"
GUI_BIN="${GUI_BIN:-/usr/bin/imagesrv-station-gui}"
BRIDGE="${BRIDGE:-$INSTALLER_DIR/gui-bridge.sh}"
RUN_DIR="${RUN_DIR:-/run/imagesrv}"
STATE_FILE="${STATE_FILE:-$RUN_DIR/install.state}"
FB_DEV="${FB_DEV:-/dev/fb0}"
CDROM="${CDROM:-/cdrom}"

note() { printf 'imagesrv installer: %s\n' "$*"; }

# #1741 (S9): with a framebuffer and the GUI binary, the hold's reason is
# drawn on the GUI, display-only (lib/failgui.sh: the Hebrew, the log's line
# under it). Shown = the GUI touched its beat; otherwise the text is the screen.
hold_screen() {
    [ -c "$FB_DEV" ] || { note "no framebuffer: the text console is the screen"; return 1; }
    [ -x "$GUI_BIN" ] || return 1
    [ -f "$INSTALLER_DIR/lib/failgui.sh" ] || { note "lib/failgui.sh is missing: text only"; return 1; }
    # shellcheck source=installer/lib/failgui.sh
    . "$INSTALLER_DIR/lib/failgui.sh" || return 1
    failgui_installer "$1" > "$RUN_DIR/hold.state" || { note "cannot write $RUN_DIR/hold.state: text only"; return 1; }
    rm -f "$RUN_DIR/hold.beat"
    FONTCONFIG_FILE=/etc/imagesrv/fonts.conf IMAGESRV_GUI_BEAT="$RUN_DIR/hold.beat" \
        "$GUI_BIN" --backend fbdev --no-input --theme light --state "$RUN_DIR/hold.state" \
        < /dev/null > /dev/null 2> "$RUN_DIR/hold-gui.log" &
    _hs_pid=$!
    if failgui_beat "$RUN_DIR/hold.beat" "$FAILGUI_WAIT_S" kill -0 "$_hs_pid"; then
        note "the reason is on the screen (GUI)"; return 0
    fi
    kill "$_hs_pid" 2>/dev/null
    note "the GUI drew no frame (see $RUN_DIR/hold-gui.log): text only"
    return 1
}

# Wait forever, loudly: the notice is repeated every minute so that a person
# who arrives later still sees it, and a reboot never happens by surprise.
hold() {
    hold_screen "$*"
    while :; do
        note "$*"
        note "Attach a screen and keyboard and power-cycle, or install from the web wizard image."
        sleep 60
    done
}

keyboard_present() {
    # A keyboard advertises EV_KEY with the letter keys; udev names it in
    # /sys/class/input/*/capabilities/key. Any input device with the 'kbd'
    # handler is good enough here -- the GUI does its own evdev scan.
    for _h in /sys/class/input/input*/handlers /proc/bus/input/devices; do
        [ -r "$_h" ] || continue
        grep -q kbd "$_h" 2>/dev/null && return 0
    done
    return 1
}

mkdir -p "$RUN_DIR" || hold "cannot create $RUN_DIR"
umask 077

[ -f "$CDROM/imagesrv-iso.json" ] || hold "install media is not mounted on $CDROM (no imagesrv-iso.json)"
[ -x "$GUI_BIN" ] || hold "GUI binary $GUI_BIN is missing from this image"
[ -x "$BRIDGE" ] || hold "GUI bridge $BRIDGE is missing from this image"
[ -c "$FB_DEV" ] || hold "no framebuffer ($FB_DEV): no display attached"
keyboard_present || hold "no keyboard found"

export FONTCONFIG_FILE=/etc/imagesrv/fonts.conf
printf 'state=ready\npct=0\ntitle=ready\n' > "$STATE_FILE"
note "starting the install GUI on $FB_DEV"
# --install-cmd is the option's name from #1190 part 2; the #1188 build still
# calls it --wizard-cmd. Ask the binary which one it knows (positive evidence,
# not a guess by version).
if "$GUI_BIN" --help 2>&1 | grep -q -- '--install-cmd'; then _opt=--install-cmd; _cwd=--install-cwd; else _opt=--wizard-cmd; _cwd=--wizard-cwd; fi
# cwd: the GUI chdir's there before exec'ing the bridge; the #1188 default
# (/opt/imagesrv-src) does not exist in the live image -> "installer not
# available" (ESXi, 21/09). Light theme: the mockups and the console are light.
"$GUI_BIN" --screen install --backend fbdev --theme light --state "$STATE_FILE" "$_opt" "$BRIDGE" "$_cwd" "$INSTALLER_DIR"
rc=$?
if [ "$rc" -eq 0 ]; then
    # The bridge ejects and reboots on "restart"; reaching here means the GUI
    # returned first. Give the reboot a moment, then say so rather than loop.
    sleep 5
    hold "the install GUI exited (0) but the machine did not restart -- last state: $(tail -n 3 "$STATE_FILE" 2>/dev/null | tr '\n' ' ')"
fi
hold "the install GUI exited with code $rc -- last state: $(tail -n 3 "$STATE_FILE" 2>/dev/null | tr '\n' ' ')"
